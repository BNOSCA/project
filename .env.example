# 複製這份檔案為 .env，並填入實際金鑰（.env 不會被 commit）

# 主力 LLM（Engine 1 需求理解、Pipeline 3 趨勢敘述生成）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 免費備援 LLM
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=

# HuggingFace（多數公開模型不需要，備用）
HF_TOKEN=

# 貼文推薦 demo 素材：合法授權穿搭照片來源
# 免費即時申請，不用審核：https://www.pexels.com/api/
PEXELS_API_KEY=

# backend/ FastAPI 服務（post-feed-ranking 分支整合進來的設定，見 backend/config.py）
BACKEND_MODE=mock
# The parser/ranker selection is independent of durable storage.
STORAGE_BACKEND=firestore
CORS_ORIGINS=http://localhost:5173
APP_DB_PATH=./runtime/demo.sqlite3
APP_DATA_DIR=./data/catalog/combined
LLM_TIMEOUT_SECONDS=8
FIREBASE_AUTH_REQUIRED=false
ADMIN_UIDS=xxx,yyy
FIRESTORE_SYNC_ENABLED=false
FIRESTORE_SYNC_REQUIRED=false
GOOGLE_CLOUD_PROJECT=bnosca-outfit-demo
FIREBASE_STORAGE_BUCKET=bnosca-outfit-demo.firebasestorage.app
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
PORT=8000
# LLM_API_KEY=  # B 模組接入時由執行環境提供，不提交真實 key
