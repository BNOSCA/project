rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function payloadUserMatchesAuth() {
      return signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /creators/{creatorId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if ownsUserDocument(uid);
      allow write: if false;
      match /{state=**} {
        allow read: if ownsUserDocument(uid);
        allow write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /interactions/{eventId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
